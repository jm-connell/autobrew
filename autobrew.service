# ──────────────────────────────────────────────────────────────────────
# autobrew.service — systemd unit for AutoBrew controller
#
# Install:
#   sudo cp autobrew.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable autobrew.service
#   sudo systemctl start autobrew.service
#
# Logs:
#   journalctl -u autobrew -f
# ──────────────────────────────────────────────────────────────────────

[Unit]
Description=AutoBrew Fertilizer Brewing Controller
After=graphical.target
Wants=graphical.target

[Service]
# Run as the desktop user (needs GPIO and display access)
User=jon
Group=jon

# Ensure the display is available for Tkinter
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/jon/.Xauthority

# Where AutoBrew stores logs/state/settings (optional override)
Environment=AUTOBREW_STATE_DIR=/home/jon/autobrew

# Working directory
WorkingDirectory=/home/jon/autobrew

# Use the project venv's Python
ExecStart=/home/jon/autobrew/venv/bin/python main.py

# Restart on crash (but not on clean exit)
Restart=on-failure
RestartSec=5

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical.target
